{
  // Editor-only. VS Code's TypeScript server resolves this file by default, so
  // it spans every tier with the union of both runtimes' libs — enough for
  // accurate IntelliSense in any source file.
  //
  // It is NOT what verifies the code. `npm run check:types` uses
  // tsconfig.host.json and tsconfig.webview.json, which deliberately keep the
  // two environments apart (no DOM in the host, no Node in the webview).
  // eslint enforces that the webview never imports `vscode`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
