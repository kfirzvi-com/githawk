{
  "name": "githawk",
  "displayName": "GitHawk",
  "description": "A simple, fast git graph for VS Code. MIT licensed. No AI, no telemetry.",
  "version": "0.2.0",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "publisher": "kfirzvi-com",
  "author": "Kfir Zvi",
  "homepage": "https://githawk.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kfirzvi-com/githawk.git"
  },
  "bugs": {
    "url": "https://github.com/kfirzvi-com/githawk/issues"
  },
  "keywords": [
    "git",
    "git graph",
    "git history",
    "source control",
    "open source"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitHawk",
      "properties": {
        "gitHawk.commitLimit": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 100000,
          "description": "How many commits to read from history. Higher values show more of the graph and take longer to load."
        },
        "gitHawk.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Reload the graph when the repository changes, so a commit, checkout, fetch, rebase or stash made outside GitHawk — in a terminal, in the Source Control view, or by another tool — shows up without pressing Refresh.\n\nGitHawk watches git's own metadata (`HEAD`, `refs`, `packed-refs`, the index), never your working tree, and waits for an operation to settle before reloading. Turn it off if the repository lives on a slow network filesystem, where each event costs a round trip."
        },
        "gitHawk.repositoryScanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "How many directory levels below each workspace folder to search for git repositories.\n\n`0` searches the opened folders only. `2` \u2014 the default \u2014 covers a folder of projects, or a folder of buckets each holding projects.\n\nThe search skips dot-directories and heavy build directories such as `node_modules`, `dist`, and `target`, so raising it is usually cheap. Repositories nested inside another repository, including submodules and linked worktrees, are found too."
        },
        "gitHawk.aiTools": {
          "type": "array",
          "markdownDescription": "Coding agents GitHawk can start in a terminal, from a worktree or the current repository.\n\nThe command is typed into a terminal already rooted in the chosen directory, so wrappers and aliases work \u2014 replace `claude` with `npx @anthropic-ai/claude-code`, or with your own script, as you like. An entry missing `name` or `command` is ignored.",
          "default": [
            {
              "name": "Claude Code",
              "command": "claude"
            },
            {
              "name": "Codex",
              "command": "codex"
            },
            {
              "name": "Gemini CLI",
              "command": "gemini"
            },
            {
              "name": "opencode",
              "command": "opencode"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in the picker, and used as the terminal's name."
              },
              "command": {
                "type": "string",
                "description": "Typed into the terminal verbatim."
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "gitHawk.open",
        "title": "GitHawk: Open Git Graph"
      },
      {
        "command": "gitHawk.refresh",
        "title": "GitHawk: Refresh Git Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "gitHawk.openChangedFile",
        "title": "GitHawk: Open Changes"
      },
      {
        "command": "gitHawk.clearChanges",
        "title": "GitHawk: Clear Changes",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitHawk.showLog",
        "title": "GitHawk: Show Log"
      },
      {
        "command": "gitHawk.compareCommits",
        "title": "GitHawk: Compare Commits"
      },
      {
        "command": "gitHawk.updateAllBranches",
        "title": "GitHawk: Update All Branches From Upstream"
      },
      {
        "command": "gitHawk.selectRepository",
        "title": "GitHawk: Switch Repository",
        "icon": "$(repo)"
      },
      {
        "command": "gitHawk.repositories",
        "title": "GitHawk: List Discovered Repositories"
      },
      {
        "command": "gitHawk.repositoryPickItems",
        "title": "GitHawk: Describe The Repository Picker"
      },
      {
        "command": "gitHawk.manageWorktrees",
        "title": "GitHawk: Manage Worktrees",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitHawk.startAiTool",
        "title": "GitHawk: Start An AI CLI Here",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitHawk.worktrees",
        "title": "GitHawk: List Worktrees"
      },
      {
        "command": "gitHawk.worktreeItems",
        "title": "GitHawk: Describe The Worktree Manager"
      },
      {
        "command": "gitHawk.manageRemotes",
        "title": "GitHawk: Manage Remotes",
        "icon": "$(cloud)"
      },
      {
        "command": "gitHawk.remotes",
        "title": "GitHawk: List Remotes"
      }
    ],
    "keybindings": [
      {
        "command": "gitHawk.open",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "!terminalFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitHawkSidebar",
          "title": "GitHawk",
          "icon": "media/githawk-eye.svg"
        }
      ],
      "panel": [
        {
          "id": "gitHawkPanel",
          "title": "GitHawk",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gitHawkSidebar": [
        {
          "id": "gitHawkChanges",
          "name": "Changes",
          "contextualTitle": "GitHawk",
          "icon": "$(git-compare)"
        }
      ],
      "gitHawkPanel": [
        {
          "id": "gitHawkView",
          "name": "Git Graph",
          "contextualTitle": "GitHawk",
          "type": "webview",
          "icon": "$(git-branch)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitHawk.clearChanges",
          "when": "view == gitHawkChanges",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gitHawk.openChangedFile",
          "when": "false"
        },
        {
          "command": "gitHawk.clearChanges",
          "when": "false"
        },
        {
          "command": "gitHawk.compareCommits",
          "when": "false"
        },
        {
          "command": "gitHawk.repositories",
          "when": "false"
        },
        {
          "command": "gitHawk.repositoryPickItems",
          "when": "false"
        },
        {
          "command": "gitHawk.worktreeItems",
          "when": "false"
        },
        {
          "command": "gitHawk.worktrees",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -n host,webview -c blue,magenta \"npm:dev:host\" \"npm:dev:webview\"",
    "dev:host": "node esbuild.js --watch",
    "dev:webview": "vite",
    "dev:vscode": "concurrently -n host,webview -c blue,magenta \"npm:dev:host\" \"vite build --watch\"",
    "build": "npm run build:webview && node esbuild.js --production",
    "build:webview": "vite build",
    "check": "npm run check:types && npm run check:svelte && npm run lint",
    "check:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "check:svelte": "svelte-check --tsconfig tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "shots": "playwright test --grep \"looks right\" --update-snapshots",
    "dump": "vite-node scripts/dumpGraph.ts --",
    "shot:real": "node scripts/shotReal.mjs",
    "package": "npm run check && npm run test && npm run build && vsce package",
    "vscode:prepublish": "npm run build",
    "test:integration": "npm run build && vite-node tests/integration/runTest.ts",
    "shot:vscode": "npm run build && node scripts/shotVscode.mjs",
    "shot:vscode:multi": "npm run build && ./scripts/makeMultiRepoSample.sh /tmp/githawk-multi-sample && node scripts/shotVscode.mjs artifacts/vscode-multi /tmp/githawk-multi-sample repositories"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "mocha": "^11.7.6",
    "svelte": "^5.39.5",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
