{
  "name": "y",
  "displayName": "Git Graph",
  "description": "A simple, fast git graph for VS Code. No AI, no telemetry.",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitGraph.open",
        "title": "Git Graph: Open"
      }
    ],
    "keybindings": [
      {
        "command": "gitGraph.open",
        "key": "cmd+9",
        "when": "!terminalFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gitGraphPanel",
          "title": "Git Graph",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gitGraphPanel": [
        {
          "id": "gitGraphView",
          "name": "Git Graph",
          "type": "webview",
          "icon": "$(git-branch)"
        }
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -n host,webview -c blue,magenta \"npm:dev:host\" \"npm:dev:webview\"",
    "dev:host": "node esbuild.js --watch",
    "dev:webview": "vite",
    "dev:vscode": "concurrently -n host,webview -c blue,magenta \"npm:dev:host\" \"vite build --watch\"",
    "build": "npm run build:webview && node esbuild.js --production",
    "build:webview": "vite build",
    "check": "npm run check:types && npm run check:svelte && npm run lint",
    "check:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "check:svelte": "svelte-check --tsconfig tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "shots": "playwright test --grep \"looks right\" --update-snapshots",
    "package": "npm run check && npm run test && npm run build && vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
