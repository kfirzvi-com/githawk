{
  "name": "githawk",
  "displayName": "GitHawk",
  "description": "A simple, fast git graph for VS Code. MIT licensed. No AI, no telemetry.",
  "version": "0.6.0",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "publisher": "kfirzvi-com",
  "author": "Kfir Zvi",
  "homepage": "https://githawk.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kfirzvi-com/githawk.git"
  },
  "bugs": {
    "url": "https://github.com/kfirzvi-com/githawk/issues"
  },
  "keywords": [
    "git",
    "git graph",
    "git history",
    "source control",
    "open source"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitHawk",
      "properties": {
        "gitHawk.commitLimit": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 100000,
          "description": "How many commits to read from history. Higher values show more of the graph and take longer to load."
        },
        "gitHawk.blame.style": {
          "type": "string",
          "enum": ["off", "column", "endOfLine"],
          "default": "off",
          "enumDescriptions": [
            "No blame annotations.",
            "A fixed-width column of date and author on every line, coloured by commit — IntelliJ's annotate. Sits between the line numbers and the code.",
            "One label per block, at the end of its first line, leaving the code where it is."
          ],
          "markdownDescription": "Show who last changed each block of lines, in the editor.\n\nOne label per run of lines from the same commit, rather than one per line. Hover it for the full message, the author, the date, and a link that selects that commit in the graph."
        },
        "gitHawk.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Reload the graph when the repository changes, so a commit, checkout, fetch, rebase or stash made outside GitHawk — in a terminal, in the Source Control view, or by another tool — shows up without pressing Refresh.\n\nGitHawk watches git's own metadata (`HEAD`, `refs`, `packed-refs`, the index), never your working tree, and waits for an operation to settle before reloading. Turn it off if the repository lives on a slow network filesystem, where each event costs a round trip."
        },
        "gitHawk.repositoryScanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "How many directory levels below each workspace folder to search for git repositories.\n\n`0` searches the opened folders only. `2` \u2014 the default \u2014 covers a folder of projects, or a folder of buckets each holding projects.\n\nThe search skips dot-directories and heavy build directories such as `node_modules`, `dist`, and `target`, so raising it is usually cheap. Repositories nested inside another repository, including submodules and linked worktrees, are found too."
        },
        "gitHawk.aiTools": {
          "type": "array",
          "markdownDescription": "Coding agents GitHawk can start in a terminal, from a worktree or the current repository \u2014 and, with `commitMessageCommand`, ask to write a commit message.\n\n`command` is typed into a terminal already rooted in the chosen directory, so wrappers and aliases work \u2014 replace `claude` with `npx @anthropic-ai/claude-code`, or with your own script, as you like.\n\n`commitMessageCommand` is the same tool run once, non-interactively, through your default shell: the prompt and the diff arrive on its stdin, and whatever it prints becomes the message. The defaults are each tool's documented form for that (`claude -p`, `codex exec -`, and plain `gemini` or `opencode run`, which read stdin when it is not a terminal). Leave it out for a tool that has no such mode, and it stays out of the commit box's picker. An entry missing `name` or `command` is ignored.",
          "default": [
            {
              "name": "Claude Code",
              "command": "claude",
              "commitMessageCommand": "claude -p"
            },
            {
              "name": "Codex",
              "command": "codex",
              "commitMessageCommand": "codex exec -"
            },
            {
              "name": "Gemini CLI",
              "command": "gemini",
              "commitMessageCommand": "gemini"
            },
            {
              "name": "opencode",
              "command": "opencode",
              "commitMessageCommand": "opencode run"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in the picker, and used as the terminal's name."
              },
              "command": {
                "type": "string",
                "description": "Typed into the terminal verbatim."
              },
              "commitMessageCommand": {
                "type": "string",
                "description": "Run through your shell to write a commit message: the prompt and diff on stdin, the message on stdout. Omit for a tool with no non-interactive mode."
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "gitHawk.open",
        "title": "GitHawk: Open Git Graph"
      },
      {
        "command": "gitHawk.closePanel",
        "title": "GitHawk: Hide The Panel"
      },
      {
        "command": "gitHawk.refresh",
        "title": "GitHawk: Refresh Git Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "gitHawk.openChangedFile",
        "title": "GitHawk: Open Changes"
      },
      {
        "command": "gitHawk.clearChanges",
        "title": "GitHawk: Clear Changes",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitHawk.showLog",
        "title": "GitHawk: Show Log"
      },
      {
        "command": "gitHawk.compareCommits",
        "title": "GitHawk: Compare Commits"
      },
      {
        "command": "gitHawk.updateAllBranches",
        "title": "GitHawk: Update All Branches From Upstream"
      },
      {
        "command": "gitHawk.selectRepository",
        "title": "GitHawk: Switch Repository",
        "icon": "$(repo)"
      },
      {
        "command": "gitHawk.repositories",
        "title": "GitHawk: List Discovered Repositories"
      },
      {
        "command": "gitHawk.repositoryPickItems",
        "title": "GitHawk: Describe The Repository Picker"
      },
      {
        "command": "gitHawk.manageWorktrees",
        "title": "GitHawk: Manage Worktrees",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitHawk.startAiTool",
        "title": "GitHawk: Start An AI CLI Here",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitHawk.worktrees",
        "title": "GitHawk: List Worktrees"
      },
      {
        "command": "gitHawk.worktreeItems",
        "title": "GitHawk: Describe The Worktree Manager"
      },
      {
        "command": "gitHawk.manageStashes",
        "title": "GitHawk: Manage Stashes",
        "icon": "$(archive)"
      },
      {
        "command": "gitHawk.stashes",
        "title": "GitHawk: List Stashes"
      },
      {
        "command": "gitHawk.manageRemotes",
        "title": "GitHawk: Manage Remotes",
        "icon": "$(cloud)"
      },
      {
        "command": "gitHawk.remotes",
        "title": "GitHawk: List Remotes"
      },
      {
        "command": "gitHawk.toggleBlame",
        "title": "GitHawk: Toggle Blame Annotations",
        "icon": "$(person)"
      },
      {
        "command": "gitHawk.blame",
        "title": "GitHawk: Report Blame For A File"
      },
      {
        "command": "gitHawk.revealCommit",
        "title": "GitHawk: Show A Commit In The Graph"
      },
      {
        "command": "gitHawk.showUncommittedChanges",
        "title": "GitHawk: Show Uncommitted Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitHawk.changesRevealed",
        "title": "GitHawk: Report Sidebar Reveals"
      },
      {
        "command": "gitHawk.workingTree",
        "title": "GitHawk: Report Uncommitted Changes"
      },
      {
        "command": "gitHawk.blameLine",
        "title": "GitHawk: Who Wrote This Line"
      },
      {
        "command": "gitHawk.revealCommitForLine",
        "title": "GitHawk: Show This Line's Commit In The Graph"
      },
      {
        "command": "gitHawk.switchBranch",
        "title": "GitHawk: Check Out A Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitHawk.stage",
        "title": "Stage",
        "icon": "$(add)"
      },
      {
        "command": "gitHawk.unstage",
        "title": "Unstage",
        "icon": "$(remove)"
      },
      {
        "command": "gitHawk.stageAll",
        "title": "GitHawk: Stage All Changes",
        "icon": "$(add)"
      },
      {
        "command": "gitHawk.commit",
        "title": "GitHawk: Commit",
        "icon": "$(check)"
      },
      {
        "command": "gitHawk.generateCommitMessage",
        "title": "GitHawk: Write The Commit Message With An AI CLI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitHawk.revealInExplorer",
        "title": "GitHawk: Reveal In Explorer View",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitHawk.openSidebar",
        "title": "GitHawk: Open Changes Sidebar"
      },
      {
        "command": "gitHawk.revealChangedFileInExplorer",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "gitHawk.changesTree",
        "title": "GitHawk: Describe The Changes Tree"
      },
      {
        "command": "gitHawk.commitForTesting",
        "title": "GitHawk: Commit With A Given Message"
      }
    ],
    "keybindings": [
      {
        "command": "gitHawk.open",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "!terminalFocus"
      },
      {
        "command": "workbench.action.closePanel",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "focusedView == gitHawkView"
      },
      {
        "command": "gitHawk.openSidebar",
        "key": "ctrl+shift+9",
        "mac": "cmd+shift+9",
        "when": "!terminalFocus"
      },
      {
        "command": "gitHawk.revealInExplorer",
        "key": "ctrl+k x",
        "mac": "cmd+k x",
        "when": "resourceScheme == githawk-rev || isInDiffEditor"
      },
      {
        "command": "gitHawk.toggleBlame",
        "key": "ctrl+k b",
        "mac": "cmd+k b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitHawk.blameLine",
        "key": "ctrl+k h",
        "mac": "cmd+k h",
        "when": "editorTextFocus"
      },
      {
        "command": "gitHawk.revealCommitForLine",
        "key": "ctrl+k g",
        "mac": "cmd+k g",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitHawkSidebar",
          "title": "GitHawk",
          "icon": "media/githawk-mark.svg"
        }
      ],
      "panel": [
        {
          "id": "gitHawkPanel",
          "title": "GitHawk",
          "icon": "media/githawk-mark.svg"
        }
      ]
    },
    "views": {
      "gitHawkSidebar": [
        {
          "id": "gitHawkCommit",
          "name": "Commit",
          "contextualTitle": "GitHawk",
          "type": "webview",
          "icon": "$(git-commit)",
          "when": "gitHawk.workingTreeShown",
          "initialSize": 1
        },
        {
          "id": "gitHawkChanges",
          "name": "Changes",
          "contextualTitle": "GitHawk",
          "icon": "$(git-compare)"
        }
      ],
      "gitHawkPanel": [
        {
          "id": "gitHawkView",
          "name": "Git Graph",
          "contextualTitle": "GitHawk",
          "type": "webview",
          "icon": "media/githawk-mark.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "gitHawk.editorContext",
        "label": "GitHawk"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitHawk.editorContext",
          "group": "navigation@9"
        }
      ],
      "gitHawk.editorContext": [
        {
          "command": "gitHawk.blameLine",
          "group": "1_line@1"
        },
        {
          "command": "gitHawk.revealCommitForLine",
          "group": "1_line@2"
        },
        {
          "command": "gitHawk.toggleBlame",
          "group": "2_file@1"
        },
        {
          "command": "gitHawk.revealInExplorer",
          "when": "resourceScheme == githawk-rev || isInDiffEditor",
          "group": "2_file@2"
        }
      ],
      "editor/title": [
        {
          "command": "gitHawk.toggleBlame",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        },
        {
          "command": "gitHawk.revealInExplorer",
          "when": "resourceScheme == githawk-rev || isInDiffEditor && resourcePath in gitHawk.diffFiles",
          "group": "navigation@8"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitHawk.revealInExplorer",
          "when": "resourceScheme == githawk-rev || isInDiffEditor && resourcePath in gitHawk.diffFiles",
          "group": "2_files@1"
        }
      ],
      "view/title": [
        {
          "command": "gitHawk.showUncommittedChanges",
          "when": "view == gitHawkChanges",
          "group": "navigation@1"
        },
        {
          "command": "gitHawk.clearChanges",
          "when": "view == gitHawkChanges",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitHawk.stage",
          "when": "view == gitHawkChanges && viewItem =~ /^gitHawk(Unstaged|Untracked|Conflicted)(File|Group)$/",
          "group": "inline@1"
        },
        {
          "command": "gitHawk.unstage",
          "when": "view == gitHawkChanges && viewItem =~ /^gitHawkStaged(File|Group)$/",
          "group": "inline@1"
        },
        {
          "command": "gitHawk.stage",
          "when": "view == gitHawkChanges && viewItem =~ /^gitHawk(Unstaged|Untracked|Conflicted)(File|Group)$/",
          "group": "1_stage@1"
        },
        {
          "command": "gitHawk.unstage",
          "when": "view == gitHawkChanges && viewItem =~ /^gitHawkStaged(File|Group)$/",
          "group": "1_stage@1"
        },
        {
          "command": "gitHawk.revealChangedFileInExplorer",
          "when": "view == gitHawkChanges && viewItem =~ /File$/",
          "group": "2_reveal@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitHawk.openChangedFile",
          "when": "false"
        },
        {
          "command": "gitHawk.stage",
          "when": "false"
        },
        {
          "command": "gitHawk.changesTree",
          "when": "false"
        },
        {
          "command": "gitHawk.revealChangedFileInExplorer",
          "when": "false"
        },
        {
          "command": "gitHawk.commitForTesting",
          "when": "false"
        },
        {
          "command": "gitHawk.unstage",
          "when": "false"
        },
        {
          "command": "gitHawk.stashes",
          "when": "false"
        },
        {
          "command": "gitHawk.blame",
          "when": "false"
        },
        {
          "command": "gitHawk.revealCommit",
          "when": "false"
        },
        {
          "command": "gitHawk.clearChanges",
          "when": "false"
        },
        {
          "command": "gitHawk.compareCommits",
          "when": "false"
        },
        {
          "command": "gitHawk.repositories",
          "when": "false"
        },
        {
          "command": "gitHawk.repositoryPickItems",
          "when": "false"
        },
        {
          "command": "gitHawk.worktreeItems",
          "when": "false"
        },
        {
          "command": "gitHawk.worktrees",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -n host,webview -c blue,magenta \"npm:dev:host\" \"npm:dev:webview\"",
    "dev:host": "node esbuild.js --watch",
    "dev:webview": "vite",
    "dev:vscode": "concurrently -n host,webview,commit -c blue,magenta,cyan \"npm:dev:host\" \"vite build --watch\" \"GITHAWK_WEBVIEW_ENTRY=commit vite build --watch\"",
    "build": "npm run build:webview && node esbuild.js --production",
    "build:webview": "vite build && GITHAWK_WEBVIEW_ENTRY=commit vite build",
    "check": "npm run check:types && npm run check:svelte && npm run lint",
    "check:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "check:svelte": "svelte-check --tsconfig tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "shots": "playwright test --grep \"looks right\" --update-snapshots",
    "dump": "vite-node scripts/dumpGraph.ts --",
    "shot:real": "node scripts/shotReal.mjs",
    "package": "npm run check && npm run test && npm run build && vsce package",
    "vscode:prepublish": "npm run build",
    "test:integration": "npm run build && vite-node tests/integration/runTest.ts",
    "shot:vscode": "npm run build && node scripts/shotVscode.mjs",
    "shot:vscode:multi": "npm run build && ./scripts/makeMultiRepoSample.sh /tmp/githawk-multi-sample && node scripts/shotVscode.mjs artifacts/vscode-multi /tmp/githawk-multi-sample repositories"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "mocha": "^11.7.6",
    "ovsx": "^1.1.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
