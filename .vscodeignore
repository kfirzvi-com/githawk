# Everything not needed at runtime. Verified with `vsce ls`.
.vscode/**
.vscode-test/**
.github/**
node_modules/**
src/**
tests/**
scripts/**
artifacts/**
playwright-report/**
test-results/**

# Build + tooling config
esbuild.js
vite.config.ts
playwright.config.ts
svelte.config.js
eslint.config.mjs
**/tsconfig*.json

# Sources and maps
**/*.ts
dist/**/*.map

*.vsix

# Icon master — only the 256px media/icon.png ships
media/icon-1024.png

# Repo housekeeping
.gitignore

# For whoever develops GitHawk, not whoever installs it.
CLAUDE.md
CONTRIBUTING.md

# README screenshots. The Marketplace fetches these from the repository by
# URL, so shipping them inside the package would only add weight.
media/screenshots/**
