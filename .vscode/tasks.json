{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:dev",
			"detail": "Watch the extension host and rebuild the webview into dist/ for F5 debugging.",
			"type": "npm",
			"script": "dev:vscode",
			"isBackground": true,
			"problemMatcher": "$esbuild-watch",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "never",
				"group": "watch"
			}
		},
		{
			"label": "dev:harness",
			"detail": "Vite dev server for the standalone webview harness (localhost:5173).",
			"type": "npm",
			"script": "dev:webview",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"group": "watch"
			}
		},
		{
			"label": "check",
			"type": "npm",
			"script": "check",
			"problemMatcher": "$tsc",
			"group": "test"
		}
	]
}
